{
  "python.defaultInterpreterPath": "backend/venv/bin/python",
  "python.analysis.extraPaths": [
    "backend",
    "backend/app",
    "backend/app/routes",
    "backend/app/models",
    "backend/app/schemas",
    "backend/app/services"
